---
interface Props {
  inline?: boolean;
}
const { inline = false } = Astro.props;
---

<div class:list={['cookbot-links', { 'cookbot-links-inline': inline }]} role="group" aria-label="CookBotを開く">
  <a
    href="https://cookbot.jp/"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center whitespace-nowrap px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
  >
    <i class="mdi mdi-web mr-2" aria-hidden="true"></i>
    Web
  </a>
  <a
    href="https://apps.apple.com/app/cookbot/id6747275041"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center whitespace-nowrap px-4 py-2 bg-slate-900 text-white rounded-lg hover:bg-slate-800 transition-colors"
  >
    <i class="mdi mdi-apple mr-2" aria-hidden="true"></i>
    App Store
  </a>
  <a
    href="https://play.google.com/store/apps/details?id=jp.cookbot"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center whitespace-nowrap px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors"
  >
    <i class="mdi mdi-google-play mr-2" aria-hidden="true"></i>
    Google Play
  </a>
</div>

<style>
  .cookbot-links { display: flex; flex-direction: column; gap: .75rem; }
  @media (min-width: 640px) {
    .cookbot-links { flex-direction: row; flex-wrap: wrap; }
  }
  .cookbot-links-inline { flex-direction: row; flex-wrap: nowrap; }
  @media (max-width: 639px) {
    .cookbot-links-inline { gap: .375rem; }
    .cookbot-links-inline a { flex: 1; justify-content: center; padding: .5rem .375rem; font-size: .875rem; }
    .cookbot-links-inline i { display: none; }
  }
</style>
